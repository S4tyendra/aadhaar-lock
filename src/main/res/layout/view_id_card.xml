<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
                android:id="@+id/idCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_id_card"
                android:clickable="true"
                android:clipToOutline="true"
                android:elevation="6dp"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:minHeight="208dp">

                <ImageView
                    android:layout_width="220dp"
                    android:layout_height="220dp"
                    android:layout_gravity="top|end"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_id_pattern" />

                <LinearLayout
                    android:id="@+id/idFront"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        style="@style/Widget.AadhaarLock.IdLabel"
                        android:text="Aadhaar" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <com.google.android.material.imageview.ShapeableImageView
                            android:id="@+id/idPhoto"
                            android:layout_width="80dp"
                            android:layout_height="100dp"
                            android:layout_marginEnd="16dp"
                            android:contentDescription="Resident photo"
                            android:padding="1dp"
                            android:scaleType="centerCrop"
                            app:shapeAppearanceOverlay="@style/ShapeAppearance.AadhaarLock.IdPhoto"
                            app:strokeColor="?attr/colorPrimaryFixedDim"
                            app:strokeWidth="1dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/idName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textAppearance="?attr/textAppearanceTitleLarge"
                                android:textColor="?attr/colorPrimaryFixed"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/idLocalName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="?attr/textAppearanceBodyMedium"
                                android:textColor="?attr/colorPrimaryFixedDim" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="3"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Widget.AadhaarLock.IdLabel"
                                        android:text="Born" />

                                    <TextView
                                        android:id="@+id/idDob"
                                        style="@style/Widget.AadhaarLock.IdValue" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="2"
                                    android:orientation="vertical">

                                    <TextView
                                        style="@style/Widget.AadhaarLock.IdLabel"
                                        android:text="Gender" />

                                    <TextView
                                        android:id="@+id/idGender"
                                        style="@style/Widget.AadhaarLock.IdValue" />
                                </LinearLayout>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/idNumber"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.08"
                            android:maxLines="1"
                            android:textAppearance="?attr/textAppearanceTitleMedium"
                            android:textColor="?attr/colorPrimaryFixed" />

                        <TextView
                            style="@style/Widget.AadhaarLock.IdLabel"
                            android:text="Address" />

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:importantForAccessibility="no"
                            android:src="@drawable/ic_chevron"
                            app:tint="?attr/colorPrimaryFixedDim" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/idBack"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="invisible">

                    <TextView
                        style="@style/Widget.AadhaarLock.IdLabel"
                        android:text="Address" />

                    <TextView
                        android:id="@+id/idAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textAppearance="?attr/textAppearanceBodyMedium"
                        android:textColor="?attr/colorPrimaryFixed" />

                    <TextView
                        android:id="@+id/idLocalAddress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:textAppearance="?attr/textAppearanceBodySmall"
                        android:textColor="?attr/colorPrimaryFixedDim" />

                    <Space
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_weight="1"
                        android:minHeight="14dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:layout_weight="2"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.AadhaarLock.IdLabel"
                                android:text="Mobile" />

                            <TextView
                                android:id="@+id/idMobile"
                                style="@style/Widget.AadhaarLock.IdValue" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="3"
                            android:orientation="vertical">

                            <TextView
                                style="@style/Widget.AadhaarLock.IdLabel"
                                android:text="Email" />

                            <TextView
                                android:id="@+id/idEmail"
                                style="@style/Widget.AadhaarLock.IdValue" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </FrameLayout>
