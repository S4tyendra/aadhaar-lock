<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.AadhaarLock" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar" />

    <style name="Widget.AadhaarLock.Card" parent="Widget.Material3.CardView.Filled">
        <item name="android:layout_marginBottom">12dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardCornerRadius">20dp</item>
    </style>

    <style name="Widget.AadhaarLock.IdLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAppearance">?attr/textAppearanceLabelMedium</item>
        <item name="android:textColor">?attr/colorPrimaryFixedDim</item>
    </style>

    <style name="Widget.AadhaarLock.IdValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">1dp</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyMedium</item>
        <item name="android:textColor">?attr/colorPrimaryFixed</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="ShapeAppearance.AadhaarLock.IdPhoto" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
